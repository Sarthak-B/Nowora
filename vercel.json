{
  "framework": null,
  "installCommand": "echo \"static site, nothing to install\"",
  "buildCommand": "echo \"static site, nothing to build\"",
  "outputDirectory": "site",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/client/:slug",
      "destination": "/client"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "make4yu.vercel.app"
        }
      ],
      "destination": "https://make4yu.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "nowora.vercel.app"
        }
      ],
      "destination": "https://make4yu.com/:path*",
      "permanent": true
    }
  ]
}
